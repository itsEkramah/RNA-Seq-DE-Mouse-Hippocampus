^SERIES = GSE116773
!Series_title = Analysis of Notch2 conditional knockout (CKO) and wild type mouse hippocampal stem cells
!Series_pubmed_id = 31390563
!Series_summary = Regulated genes downsteam of Notch2
!Series_summary = Methods: mRNA profiles of adult wild type and Notch2 CKO neural stem cells were generated by deep sequencing, in triplicate. Two libraries were generated for each RNA sample using Nextera XT DNA Library Preparation Kit (Illumina) and sequenced by SmartSeq2 kit (Illumina) on different days. Each sample was sequenced twice in two independent lanes on a Illumina HiSeq 2500. The sequence reads that passed quality filters were mapped to the mouse genome (GRCm38) by Bowtie2 and transcript identification and quantification were performed using HTSeq. qRT–PCR validation was performed using SYBR Green assays.
!Series_summary = Results: This study identifies Notch2 regulated genes in neurogenic neural stem cells of the adult mouse hippocampus.
!Series_overall_design = mRNA profiles of adult wild type and Notch2 CKO neural stem cells were generated by deep sequencing, in triplicate.
!Series_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE116nnn/GSE116773/suppl/GSE116773_RAW.tar
!Series_relation = BioProject: https://www.ncbi.nlm.nih.gov/bioproject/PRJNA480214
!Series_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRP152804
^SAMPLE = GSM3261582
!Sample_title = WT1_rep1_1
!Sample_geo_accession = GSM3261582
!Sample_source_name_ch1 = Hippocampal stem cells
!Sample_characteristics_ch1 = strain: C57BL/6
!Sample_characteristics_ch1 = tissue: Hippocampus
!Sample_characteristics_ch1 = age: Adult
!Sample_characteristics_ch1 = genotype: Wild type
!Sample_treatment_protocol_ch1 = Hes5::CreERT2, Notch2 flox/flox, Rosa26R-CAG::GFP mice (Notch2 CKO) and  Hes5::CreERT2, Notch2 wt/wt Rosa26R-CAG::GFP mice (wild type) were treated 5 days with Tamoxifen  and GFP+ cells isolated after a 1 day chase.
!Sample_extract_protocol_ch1 = Hes5::CreERT2 derived cells were isolated by sorting of Rosa26R-CAG::GFP recombined GFP+ cells after 5 days of Tamoxifen treatment and 1 day chase. Sorted cells from pools of wild type or Notch2 CKO animals were lysed into Trisol and RNA extracted.
!Sample_extract_protocol_ch1 = Nextera XT DNA Library Preparation Kit (Illumina)
!Sample_extract_protocol_ch1 = Smart-Seq2 (Illumina) RNA-Seq
!Sample_description = BSSE_QGF_41399_C87PPANXX_4_20K_CAGGFP_rep1_new_cDNA_Jan2016_ACTCGCTA_CTCTCTAT_S1_L004_R1_001.fastq
!Sample_data_processing = For data processing with Bowtie2 and Htseq go to https://github.com/mboareto/Notch2KO
!Sample_data_processing = Genome_build: Mus Musculus GRCm38
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
